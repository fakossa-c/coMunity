# Modèle des variables d'environnement. Aucune valeur ici : ce fichier est commité.
# En local, `npm run env:local` écrit ces valeurs dans .env.local.
# En production, elles se saisissent dans Vercel (voir docs/deploiement.md), jamais dans le dépôt.

# Supabase : URL du projet et clé publiable (anciennement « anon »).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (anciennement « service_role ») : côté serveur uniquement, jamais préfixée NEXT_PUBLIC_.
# Sert à envoyer les invitations du syndic, au script d'amorçage et à publier les activités une
# fois Jev entendu : sans elle, une activité créée ou modifiée reste en relecture.
SUPABASE_SECRET_KEY=

# Posées par Vercel lui-même (variables système), à ne jamais saisir : en production, les liens
# partagés des fiches prennent le domaine de production plutôt que celui de la requête.
VERCEL_ENV=
VERCEL_PROJECT_PRODUCTION_URL=

# Jev (facultatif) : clé OpenRouter de l'assistant de création, côté serveur uniquement. Sans clé,
# l'assistant ne suggère rien et ne pré-modère rien. L'adresse d'OpenRouter ne se change que pour
# les tests de bout en bout.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Tests de bout en bout seulement, à ne jamais saisir : ouvre la page /essai-erreur, dont la lecture
# échoue à la demande. Sans elle, cette page est introuvable.
ESSAI_ERREUR_E2E=

# Outillage seulement (scripts/orch/), à ne jamais saisir en production : dossier d'état d'un essai
# de la boucle de livraison, à la place de celui de la config globale. Posé par `--etat`.
ORCH_DOSSIER_ETAT=
